# 콜노트(가칭) T07 데모 앱 — /etc/systemd/system/callnote-app.service
# 공개 저장소의 코드를 자동 실행하므로 전용 사용자 callnote 로 가두고 메모리·CPU 를 묶는다.
# 같은 서버의 실서비스(nolmeok)보다 먼저 정리되도록 OOMScoreAdjust 를 높게 둔다.
[Unit]
Description=callnote T07 demo app
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=callnote
Group=callnote
EnvironmentFile=/etc/callnote/app.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=200
WorkingDirectory=/srv/callnote
ExecStart=/usr/local/lib/callnote-deploy/run-app.sh
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadWritePaths=/var/lib/callnote

MemoryHigh=260M
MemoryMax=300M
MemorySwapMax=200M
CPUQuota=120%
TasksMax=64
Nice=5
OOMScoreAdjust=800

[Install]
WantedBy=multi-user.target
