# 처음 실행할 때 .env로 복사한다. .env는 저장소에 올리지 않는다.
# Compose는 컨테이너의 HOST=0.0.0.0, PORT=5600, DATA_DIR=/data를 지정한다.
HOST=127.0.0.1
PORT=5600
# DATA_DIR=/absolute/path/to/ahmatda-data
AHMATDA_BIND=127.0.0.1
AHMATDA_PORT=5600
PUBLIC_BASE_URL=http://127.0.0.1:5600
TRUST_PROXY=0

# 비공개 작업공간의 로컬 체험. outbox는 인증 링크를 서버 파일에 저장한다.
DEMO_MODE=0
AUTH_MAIL_MODE=outbox
LEGACY_WORKSPACE_OWNER_EMAIL=
AHMATDA_DOMAIN=automotive@1

# off | fixture | anthropic. 유료 호출은 추가 설정과 작업공간의 동의가 필요하다.
AI_PROVIDER=fixture
ALLOW_PAID_AI=0
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
DAILY_AI_LIMIT=400

# GPU 일꾼과 업로드 (선택). 비공개 ingest 토큰은 작업공간에서 발급한다.
WORKER_WORKSPACE_ID=
WORKER_TOKEN=
INGEST_TOKEN=
DAILY_UPLOAD_LIMIT=100
MAX_UPLOAD_BYTES=10485760
MAX_AUDIO_SEC=300
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 공개 가짜 데모 관리자 (선택).
ADMIN_PASSCODE=
