# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.

# ── 음성 인식 ─────────────────────────────
# none           : 녹음 대신 받아쓴 글(.txt)만 처리
# faster-whisper : PC 안에서 처리 (녹음이 밖으로 나가지 않음) — pip install faster-whisper
# openai         : OpenAI API로 전송 — pip install openai
STT_BACKEND=none
WHISPER_MODEL=small
OPENAI_STT_MODEL=whisper-1

# ── 주문 카드 추출 ─────────────────────────
# rule      : 규칙 기반 (API 키 불필요, 데모·비교용)
# anthropic : Claude API
# openai    : OpenAI API
# ollama    : PC 안 로컬 모델 (https://ollama.com, 예: ollama pull qwen2.5:7b)
LLM_PROVIDER=rule
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# 데이터(주문 DB·올린 녹음) 저장 위치, 낱말 사전 위치
# ORDER_AI_DATA_DIR=./var
# GLOSSARY_PATH=./glossary.csv
