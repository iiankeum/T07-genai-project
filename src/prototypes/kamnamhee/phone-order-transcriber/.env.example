# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.

# ── 음성 인식 ─────────────────────────────
# none           : 녹음 대신 받아쓴 글(.txt)만 처리
# faster-whisper : PC 안에서 처리 (녹음이 밖으로 나가지 않음) — pip install -r requirements-stt.txt
# openai         : OpenAI API로 전송 — pip install openai
STT_BACKEND=none
WHISPER_MODEL=small
# whisper-1은 2027-02-26 OpenAI에서 종료 예정 (대체: gpt-transcribe, 파라미터 확인 필요)
OPENAI_STT_MODEL=whisper-1

# ── 주문 카드 추출 ─────────────────────────
# rule      : 규칙 기반 (API 키 불필요, 데모·비교용)
# anthropic : Claude API
# openai    : OpenAI API
# ollama    : PC 안 로컬 모델 (https://ollama.com, 예: ollama pull qwen2.5:7b)
LLM_PROVIDER=rule
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 워크스페이스에 묶이지 않은 Claude 키라면 워크스페이스 ID를 넣는다 (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
# gpt-4o-mini는 2027-01-14 OpenAI에서 종료 예정 (권장 대체: gpt-6-luna)
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# AI 응답 대기 시간(초). 비우면 120초, Ollama는 300초. CPU만 있는 PC에서 7B 모델은 몇 분 걸릴 수 있다.
LLM_TIMEOUT=

# 데이터(주문 DB·올린 녹음) 저장 위치, 낱말 사전 위치
# ORDER_AI_DATA_DIR=./var
# GLOSSARY_PATH=./glossary.csv

# ── 웹 서버 ────────────────────────────────
# 디버그 모드는 1일 때만 켠다. 다른 사람이 접속할 수 있는 상태에서는 켜지 않는다.
FLASK_DEBUG=0
# 비워 두면 실행할 때마다 무작위로 만든다
SECRET_KEY=
