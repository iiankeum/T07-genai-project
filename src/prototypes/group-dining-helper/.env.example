# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.

# ── 의견 → 조건 정리 ───────────────────────
# rule      : 규칙 기반 (API 키 불필요, 데모·비교용)
# anthropic : Claude API
# openai    : OpenAI API
# ollama    : PC 안 로컬 모델 (https://ollama.com, 예: ollama pull qwen2.5:7b)
LLM_PROVIDER=rule
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 워크스페이스에 묶이지 않은 Claude 키라면 워크스페이스 ID를 넣는다 (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
# gpt-4o-mini는 2027-01-14 OpenAI에서 종료 예정 (권장 대체: gpt-6-luna)
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# AI 응답 대기 시간(초). 비우면 120초, Ollama는 300초. CPU만 있는 PC에서 7B 모델은 몇 분 걸릴 수 있다.
LLM_TIMEOUT=

# 식당 데이터 폴더 (회사 주변 식당으로 바꿀 때), 모임·투표 DB 위치
# RESTAURANT_DIR=./data
# DINING_DATA_DIR=./var

# 같은 와이파이의 휴대폰에서 투표 화면을 열려면 0.0.0.0
# HOST=127.0.0.1
# PORT=5000
# 디버그 모드는 1일 때만 켠다. HOST=0.0.0.0으로 공유할 때는 절대 켜지 않는다.
FLASK_DEBUG=0
# 세션 서명 키. 비워 두면 var/secret_key에 무작위로 만들어 둔다
SECRET_KEY=
