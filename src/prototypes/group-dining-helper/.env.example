# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.

# ── 의견 → 조건 정리 ───────────────────────
# rule      : 규칙 기반 (API 키 불필요, 데모·비교용)
# anthropic : Claude API
# openai    : OpenAI API
# ollama    : PC 안 로컬 모델 (https://ollama.com, 예: ollama pull qwen2.5:7b)
LLM_PROVIDER=rule
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# 식당 데이터 폴더 (회사 주변 식당으로 바꿀 때), 모임·투표 DB 위치
# RESTAURANT_DIR=./data
# DINING_DATA_DIR=./var

# 같은 와이파이의 휴대폰에서 투표 화면을 열려면 0.0.0.0
# HOST=127.0.0.1
# PORT=5000
